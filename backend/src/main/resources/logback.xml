<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- SQL statements are logged at DEBUG/TRACE; failures are still logged at ERROR. -->
    <logger name="Exposed" level="INFO" />

    <!-- Suppress noisy Quartz DEBUG output such as "batch acquisition of 0 triggers". -->
    <logger name="org.quartz" level="INFO" />
</configuration>
